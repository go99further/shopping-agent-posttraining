+def expand_grouped_merged_lora_slices(layer, lora_a, lora_b):
+    """Expand grouped PEFT LoRA tensors to vLLM packed-layer slices.
+
+    Qwen3.5's Hugging Face linear-attention block exposes two adapter
+    modules, ``in_proj_qkv`` and ``in_proj_z``.  vLLM packs the same base
+    projection into four physical slices (q, k, v, z).  The regular vLLM
+    loader assumes one adapter tensor per physical slice, so it attempts to
+    copy the 6144-row qkv LoRA-B tensor into the first 2048-row slice.
+
+    Split only when the number of PEFT groups differs from the number of
+    physical slices.  Every source row must be consumed exactly once; this
+    preserves the adapter numerically and fails closed on unknown layouts.
+    """
+    if not isinstance(lora_a, (list, tuple)) or not isinstance(lora_b, (list, tuple)):
+        return lora_a, lora_b
+    if len(lora_a) != len(lora_b):
+        raise ValueError(
+            f"Mismatched grouped LoRA tensors: {len(lora_a)} A tensors and {len(lora_b)} B tensors"
+        )
+    if len(lora_a) == layer.n_slices:
+        return lora_a, lora_b
+
+    output_sizes = tuple(int(size) for size in layer.base_layer.output_sizes)
+    if len(output_sizes) != layer.n_slices:
+        raise ValueError(
+            f"Invalid packed-layer metadata: {len(output_sizes)} output sizes for {layer.n_slices} slices"
+        )
+
+    expanded_a = []
+    expanded_b = []
+    slice_index = 0
+    for group_index, (group_a, group_b) in enumerate(zip(lora_a, lora_b)):
+        if group_a is None or group_b is None:
+            raise ValueError(
+                "Cannot infer physical slice coverage for a missing grouped LoRA tensor "
+                f"at group {group_index}"
+            )
+        if not torch.is_tensor(group_a) or not torch.is_tensor(group_b) or group_b.ndim != 2:
+            raise TypeError(f"Unsupported grouped LoRA tensor types at group {group_index}")
+
+        group_rows = int(group_b.shape[0])
+        row_offset = 0
+        while row_offset < group_rows:
+            if slice_index >= len(output_sizes):
+                raise ValueError(
+                    f"Grouped LoRA-B tensor {group_index} has {group_rows} rows beyond packed-layer capacity"
+                )
+            slice_rows = output_sizes[slice_index]
+            next_offset = row_offset + slice_rows
+            if next_offset > group_rows:
+                raise ValueError(
+                    f"Grouped LoRA-B tensor {group_index} with {group_rows} rows cannot be split at "
+                    f"packed slice {slice_index} of size {slice_rows}"
+                )
+            expanded_a.append(group_a)
+            expanded_b.append(group_b[row_offset:next_offset, :])
+            row_offset = next_offset
+            slice_index += 1
+
+    if slice_index != layer.n_slices:
+        raise ValueError(
+            f"Grouped LoRA tensors cover {slice_index} of {layer.n_slices} packed-layer slices"
+        )
+    return expanded_a, expanded_b
+
